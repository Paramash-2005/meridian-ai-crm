# Used by docker-compose.yml only (local dev via `npm run dev` reads server/.env instead).
# Copy this file to `.env` in the project root and fill in real values before running
# `docker compose up`. Never commit the real `.env`.

MONGO_ROOT_USER=meridian_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-long-random-string

# Leave blank to run AI features in mock mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
