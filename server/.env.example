PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/meridian-crm
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=12h
REDIS_URL=redis://127.0.0.1:6379
CLIENT_ORIGIN=http://localhost:5173

# Leave blank to run AI features in mock mode (no cost, no external calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only if mongodb+srv lookups fail locally (querySrv ECONNREFUSED):
# DNS_SERVERS=8.8.8.8,1.1.1.1
